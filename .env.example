PLATO_BASE_URL=https://api.bltcy.ai
PLATO_API_KEY=your_key_here
PLATO_AUTH_MODE=x-api-key
PLATO_MODEL_IMAGE2=gpt-image-2-all
PLATO_MODEL_NAMING=gemini-3.1-flash-lite-preview
PLATO_MODEL_SLICER=gemini-3-pro-preview
PLATO_GENERATIONS_PATH=/v1/images/generations
PLATO_TASKS_PATH_PREFIX=/v1/images/tasks
PLATO_CHAT_COMPLETIONS_PATH=/v1/chat/completions
PLATO_ASYNC=false

# Auth / email verify
AUTH_DEV_ECHO_CODE=true
AUTH_EMAIL_FROM=no-reply@example.com
AUTH_RESEND_API_KEY=
AUTH_RESEND_BASE_URL=https://api.resend.com
AUTH_RESEND_TIMEOUT_MS=10000
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=465
AUTH_SMTP_USER=
AUTH_SMTP_PASS=
AUTH_SMTP_CONNECT_TIMEOUT_MS=10000
AUTH_SMTP_GREETING_TIMEOUT_MS=10000
AUTH_SMTP_SOCKET_TIMEOUT_MS=15000

# Data persistence directory (set to a persistent disk path in production)
APP_DATA_DIR=./api/data

# JWT auth secret (required in production)
AUTH_JWT_SECRET=change-this-jwt-secret

# Upstash Redis (recommended for persistent users/quota across deploys)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Quota admin whitelist (comma-separated emails)
QUOTA_ADMIN_WHITELIST=
